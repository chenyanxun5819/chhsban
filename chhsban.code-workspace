	"settings": {
		"files.exclude": {
			"**/node_modules": true,
			"**/.next": true,
			"**/.venv": true,
			"**/dist": true,
			"**/build": true,
			"**/__pycache__": true,
			"**/*.pyc": true
		},
		"search.exclude": {
			"**/node_modules": true,
			"**/dist": true,
			"**/.next": true,
			"**/__pycache__": true
		},
		"[typescript]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.formatOnSave": true
		},
		"[javascript]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"editor.formatOnSave": true
		},
		"[python]": {
			"editor.defaultFormatter": "ms-python.python",
			"editor.formatOnSave": true
		},
		"python.linting.enabled": true,
		"python.linting.pylintEnabled": true
	},
	"extensions": {
		"recommendations": [
			"esbenp.prettier-vscode",
			"ms-python.python",
			"ms-python.vscode-pylance",
			"eamodio.gitlens",
			"cloudflare.wrangler",
			"styled-components.vscode-styled-components"
		]
	}
}
