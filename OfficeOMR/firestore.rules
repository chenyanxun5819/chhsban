rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== M6 FIRESTORE SECURITY RULES ==========
    // 基于 Custom Claims 的多角色权限管理
    // 参考: PLAN.md 第 3.2、9.4 节

    // ========== 辅助函数 ==========
    
    // 检查用户是否已认证
    function isAuthenticated() {
      return request.auth != null;
    }

    // 检查用户是否是 super_admin（无 orgId）
    function isSuperAdmin() {
      return isAuthenticated() 
        && request.auth.token.role == 'super_admin';
    }

    // 检查用户是否是 teacher，且属于指定组织
    function isTeacherInOrg(orgId) {
      return isAuthenticated() 
        && request.auth.token.role == 'teacher'
        && request.auth.token.orgId == orgId;
    }

    // 检查用户是否是 teacher（任意组织）
    function isTeacher() {
      return isAuthenticated() 
        && request.auth.token.role == 'teacher';
    }

    // 检查教师的 active 状态
    // 规则要点：即使 ID token 未过期，active=false 也拒绝访问
    // 这保证了"停用后立即失效"的要求
    function isTeacherActive() {
      return isTeacher() 
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.active == true;
    }

    // 获取用户所属组织 ID
    function getUserOrgId() {
      return request.auth.token.orgId;
    }

    // 获取用户邮箱（小写）
    function getUserEmail() {
      return request.auth.token.email;
    }

    // ========== settings/global 集合 ==========
    // 路径: settings/global
    // 数据模型见 3.2 节
    // 规则: super_admin 读写，teacher 只读

    match /settings/global {
      // super_admin 读写
      allow read, write: if isSuperAdmin();
      
      // teacher 只读
      allow read: if isTeacherActive();
    }

    // ========== orgs/{orgId} 集合 ==========
    // 路径: orgs/{orgId}
    // 数据模型见 3.2 节
    // 规则: super_admin 读写，teacher 只读自己的组织

    match /orgs/{orgId} {
      // super_admin 读写
      allow read, write: if isSuperAdmin();
      
      // teacher 只读自己的组织（且必须 active）
      allow read: if isTeacherActive() && isTeacherInOrg(orgId);
    }

    // ========== allowedUsers/{email} 集合 ==========
    // 路径: allowedUsers/{email_lowercase}
    // 数据模型见 3.2 节
    // 规则: 仅 super_admin 读写（客户端完全无权）

    match /allowedUsers/{email} {
      // 仅 super_admin 读写
      allow read, write: if isSuperAdmin();
    }

    // ========== jobs/{jobId} 集合 ==========
    // 路径: jobs/{jobId}
    // 数据模型见 3.2 节、M7 实现
    // 规则: teacher 只读自己的（写入由 Functions 完成）
    //       关键：M7 answerKey 永久保存，防止删除
    //       更新操作不能删除 answerKey 字段

    match /jobs/{jobId} {
      // teacher 只读自己的（检查 active 状态）
      allow read: if isTeacherActive() 
        && resource.data.uid == request.auth.uid;
      
      // 防止 answerKey 被删除（M7 关键保护）
      // 任何尝试删除 answerKey 字段的操作都被拒绝
      allow update: if isTeacherActive()
        && !('answerKey' in request.resource.data.diff(resource.data).affectedKeys());
      
      // 写入：仅由 Cloud Functions 完成（服务账号）
      // 前端无直接写权限
      allow create, write: if false;
    }

    // ========== usage/{uid}_{yyyymmdd} 集合 ==========
    // 路径: usage/{uid}_{yyyymmdd}
    // 例如: usage/user123_20261107
    // 数据模型: { "sheets": 123 }
    // 规则: super_admin 只读，Cloud Functions 写入

    match /usage/{document=**} {
      // super_admin 只读（用于管理后台统计）
      allow read: if isSuperAdmin();
      
      // 写入：仅由 Cloud Functions 完成（服务账号）
      allow write: if false;
    }

    // ========== 其他所有集合 ==========
    // 默认拒绝访问
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
