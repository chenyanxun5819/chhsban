<!DOCTYPE html>
<html lang="zh-Hans">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OfficeOMR — 答题纸识别系统</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 600px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      overflow: hidden;
    }

    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 40px 30px;
      text-align: center;
    }

    .header h1 {
      font-size: 28px;
      margin-bottom: 8px;
      font-weight: 600;
    }

    .header p {
      font-size: 14px;
      opacity: 0.9;
    }

    .content {
      padding: 40px 30px;
    }

    /* ========== 登录界面 ========== */
    #login-section {
      text-align: center;
    }

    .login-description {
      color: #666;
      font-size: 14px;
      margin-bottom: 30px;
      line-height: 1.6;
    }

    .google-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: white;
      border: 2px solid #ddd;
      border-radius: 8px;
      padding: 12px 24px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      color: #333;
    }

    .google-btn:hover {
      border-color: #667eea;
      background: #f9f9f9;
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.2);
    }

    .google-btn svg {
      width: 20px;
      height: 20px;
      margin-right: 10px;
    }

    /* ========== 仪表板 ========== */
    #dashboard {
      display: none;
    }

    .user-info {
      background: #f5f5f5;
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .user-email {
      font-size: 14px;
      color: #666;
    }

    .user-email strong {
      color: #333;
      display: block;
      font-size: 16px;
      margin-bottom: 4px;
    }

    .logout-btn {
      background: #f5f5f5;
      border: 1px solid #ddd;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 13px;
      cursor: pointer;
      color: #333;
      transition: all 0.3s ease;
    }

    .logout-btn:hover {
      background: #ffe5e5;
      border-color: #ff6b6b;
      color: #ff6b6b;
    }

    /* ========== 上传表单 ========== */
    .upload-section {
      margin-bottom: 30px;
    }

    .section-title {
      font-size: 16px;
      font-weight: 600;
      color: #333;
      margin-bottom: 15px;
      display: flex;
      align-items: center;
    }

    .section-title::before {
      content: '';
      display: inline-block;
      width: 4px;
      height: 4px;
      background: #667eea;
      border-radius: 50%;
      margin-right: 10px;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #333;
      margin-bottom: 6px;
    }

    .file-input-wrapper {
      position: relative;
      display: inline-block;
      width: 100%;
    }

    .file-input-wrapper input[type='file'] {
      position: absolute;
      left: -9999px;
    }

    .file-input-label {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      border: 2px dashed #ddd;
      border-radius: 8px;
      background: #fafafa;
      cursor: pointer;
      transition: all 0.3s ease;
      font-size: 14px;
      color: #666;
    }

    .file-input-label:hover {
      border-color: #667eea;
      background: #f0f4ff;
      color: #667eea;
    }

    .file-input-label.has-file {
      background: #e3f2fd;
      border-color: #667eea;
      color: #667eea;
      font-weight: 600;
    }

    .file-input-icon {
      width: 20px;
      height: 20px;
      margin-right: 8px;
    }

    .template-select {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 13px;
      color: #333;
      background: white;
      cursor: pointer;
    }

    .template-select:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    /* ========== 按钮 ========== */
    .submit-btn {
      width: 100%;
      padding: 12px;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-top: 10px;
    }

    .submit-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
    }

    .submit-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    /* ========== 进度与状态 ========== */
    #status {
      margin-top: 15px;
      padding: 12px;
      border-radius: 6px;
      font-size: 13px;
      display: none;
      text-align: center;
    }

    #status.success {
      background: #e8f5e9;
      color: #2e7d32;
      border: 1px solid #c8e6c9;
      display: block;
    }

    #status.error {
      background: #ffebee;
      color: #c62828;
      border: 1px solid #ffcdd2;
      display: block;
    }

    #status.info {
      background: #e3f2fd;
      color: #1565c0;
      border: 1px solid #bbdefb;
      display: block;
    }

    #status.warning {
      background: #fff3e0;
      color: #e65100;
      border: 1px solid #ffe0b2;
      display: block;
    }

    .progress-bar {
      width: 100%;
      height: 6px;
      background: #eee;
      border-radius: 3px;
      overflow: hidden;
      margin-top: 10px;
      display: none;
    }

    .progress-bar.active {
      display: block;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
      width: 0%;
      transition: width 0.3s ease;
    }

    /* ========== 结果区域 ========== */
    #result-section {
      margin-top: 30px;
      padding-top: 30px;
      border-top: 1px solid #eee;
      display: none;
    }

    .result-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin-bottom: 20px;
    }

    .result-item {
      background: #f5f5f5;
      padding: 15px;
      border-radius: 6px;
      text-align: center;
    }

    .result-item-value {
      font-size: 24px;
      font-weight: 700;
      color: #667eea;
      margin-bottom: 4px;
    }

    .result-item-label {
      font-size: 12px;
      color: #999;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .annotated-image {
      width: 100%;
      max-height: 400px;
      border-radius: 6px;
      margin: 20px 0;
      background: #f5f5f5;
      object-fit: contain;
    }

    .result-buttons {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 15px;
    }

    .result-btn {
      padding: 10px 15px;
      border: 1px solid #ddd;
      border-radius: 6px;
      background: white;
      color: #333;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .result-btn:hover {
      border-color: #667eea;
      color: #667eea;
      background: #f5f5ff;
    }

    .result-btn.primary {
      background: #667eea;
      color: white;
      border-color: #667eea;
    }

    .result-btn.primary:hover {
      background: #5568d3;
      border-color: #5568d3;
    }

    /* ========== 状态指示器 ========== */
    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-left: 10px;
    }

    .status-badge.success {
      background: #e8f5e9;
      color: #2e7d32;
    }

    .status-badge.processing {
      background: #e3f2fd;
      color: #1565c0;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    .status-badge.error {
      background: #ffebee;
      color: #c62828;
    }

    /* ========== 响应式 ========== */
    @media (max-width: 600px) {
      .content {
        padding: 30px 20px;
      }

      .result-grid {
        grid-template-columns: 1fr;
      }

      .result-buttons {
        grid-template-columns: 1fr;
      }

      .header {
        padding: 30px 20px;
      }

      .header h1 {
        font-size: 24px;
      }
    }

    /* ========== 动画 ========== */
    .fade-in {
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ========== 加载动画 ========== */
    .spinner {
      display: inline-block;
      width: 20px;
      height: 20px;
      border: 3px solid rgba(102, 126, 234, 0.3);
      border-top-color: #667eea;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-right: 8px;
      vertical-align: middle;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <h1>OfficeOMR</h1>
      <p>智能答题纸识别系统</p>
    </div>

    <!-- Content -->
    <div class="content">
      <!-- Login Section -->
      <div id="login-section">
        <div class="login-description">
          <p>使用 Google 账号登录，开始识别答题纸。</p>
          <p style="font-size: 12px; color: #999; margin-top: 10px;">
            仅支持已批准的邮箱地址。请向管理员申请开通。
          </p>
        </div>
        <button id="login-btn" class="google-btn">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <g transform="matrix(1, 0, 0, 1, 27.009766, -39.238281)">
              <path fill="#4285F4" d="M -3.264 51.509 C -3.264 50.719 -3.334 49.969 -3.454 49.239 L -14.754 49.239 L -14.754 53.749 L -8.284 53.749 C -8.574 55.229 -9.424 56.479 -10.684 57.329 L -10.684 60.329 L -6.824 60.329 C -4.564 58.239 -3.264 55.159 -3.264 51.509 Z"/>
              <path fill="#34A853" d="M -14.754 63.239 C -11.514 63.239 -8.804 62.159 -6.824 60.329 L -10.684 57.329 C -11.764 58.049 -13.134 58.489 -14.754 58.489 C -17.884 58.489 -20.534 56.379 -21.484 53.529 L -25.464 53.529 L -25.464 56.619 C -23.494 60.539 -19.444 63.239 -14.754 63.239 Z"/>
              <path fill="#FBBC05" d="M -21.484 53.529 C -21.734 52.809 -21.864 52.039 -21.864 51.239 C -21.864 50.439 -21.724 49.669 -21.484 48.949 L -21.484 45.859 L -25.464 45.859 C -26.284 47.479 -26.754 49.299 -26.754 51.239 C -26.754 53.179 -26.284 54.999 -25.464 56.619 L -21.484 53.529 Z"/>
              <path fill="#EA4335" d="M -14.754 43.989 C -13.004 43.989 -11.404 44.599 -10.154 45.789 L -6.734 42.369 C -8.804 40.429 -11.514 39.239 -14.754 39.239 C -19.444 39.239 -23.494 41.939 -25.464 45.859 L -21.484 48.949 C -20.534 46.099 -17.884 43.989 -14.754 43.989 Z"/>
            </g>
          </svg>
          使用 Google 账号登录
        </button>
      </div>

      <!-- Dashboard -->
      <div id="dashboard">
        <!-- User Info -->
        <div class="user-info">
          <div class="user-email">
            <strong id="user-display-name">用户</strong>
            <span id="user-email-display"></span>
          </div>
          <button id="logout-btn" class="logout-btn">退出登录</button>
        </div>

        <!-- Upload Section -->
        <div class="upload-section">
          <div class="section-title">上传答题纸</div>

          <div class="form-group">
            <label>选择图片（PNG、JPG 或 PDF）</label>
            <div class="file-input-wrapper">
              <input type="file" id="file-input" accept="image/*,.pdf" required />
              <label for="file-input" class="file-input-label">
                <svg class="file-input-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/>
                </svg>
                点击选择或拖拽文件
              </label>
            </div>
          </div>

          <div class="form-group">
            <label>选择答题纸版型</label>
            <select id="template-select" class="template-select" required>
              <option value="T100-A4-v1">T100 — 100 题 (A4)</option>
              <option value="T060-A4-v1">T060 — 60 题 (A4)</option>
            </select>
          </div>

          <button id="upload-btn" class="submit-btn" disabled>
            <span class="spinner" style="display: none;"></span>
            开始识别
          </button>

          <div id="status"></div>

          <div class="progress-bar" id="progress-bar">
            <div class="progress-fill" id="progress-fill"></div>
          </div>
        </div>

        <!-- Result Section -->
        <div id="result-section" class="fade-in">
          <div class="section-title">识别结果</div>

          <div class="result-grid">
            <div class="result-item">
              <div class="result-item-value" id="result-student-id">-</div>
              <div class="result-item-label">学号</div>
            </div>
            <div class="result-item">
              <div class="result-item-value" id="result-single">-</div>
              <div class="result-item-label">单选题数</div>
            </div>
            <div class="result-item">
              <div class="result-item-value" id="result-blank">-</div>
              <div class="result-item-label">空白题数</div>
            </div>
            <div class="result-item">
              <div class="result-item-value" id="result-multi">-</div>
              <div class="result-item-label">多选题数</div>
            </div>
            <div class="result-item">
              <div class="result-item-value" id="result-ambiguous">-</div>
              <div class="result-item-label">存疑题数</div>
            </div>
            <div class="result-item">
              <div class="result-item-value" id="result-status">-</div>
              <div class="result-item-label">状态</div>
            </div>
          </div>

          <div id="result-error-section" style="display: none; margin-top: 15px; padding: 15px; background: #fef3cd; border: 1px solid #ffeaa7; border-radius: 6px;">
            <div style="color: #856404; font-size: 12px; font-weight: 600; margin-bottom: 8px;">错误详情</div>
            <div style="color: #856404; font-size: 13px;">
              <div><strong>代码:</strong> <span id="result-error-code">-</span></div>
              <div><strong>信息:</strong> <span id="result-error-message">-</span></div>
            </div>
          </div>

          <img id="annotated-image" class="annotated-image" style="display: none;" />

          <div class="result-buttons">
            <button id="download-result-btn" class="result-btn primary">下载结果 JSON</button>
            <button id="new-upload-btn" class="result-btn">识别新图片</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Firebase SDK (compat builds for non-module script usage) -->
  <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-storage-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-firestore-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-functions-compat.js"></script>

  <!-- M7 Service Module -->
  <script src="/js/services/m7-service.js"></script>

  <!-- Firebase Configuration & App Logic -->
  <script>
    // ========== Firebase Configuration ==========
    const firebaseConfig = {
      apiKey: "AIzaSyCmppoQXk7osjxv-p700JCBLniGRrxOYV0",
      authDomain: "officeomr-fe542.firebaseapp.com",
      projectId: "officeomr-fe542",
      storageBucket: "officeomr-fe542.firebasestorage.app",
      messagingSenderId: "601814582794",
      appId: "1:601814582794:web:9de9f7f427b8b3406bc1f3"
    };

    if (!firebaseConfig.apiKey || firebaseConfig.apiKey.includes('DEXAMPLE')) {
      console.error('Invalid Firebase config: apiKey is missing or placeholder');
      alert('Firebase 配置错误：请检查 web/index.html 中的 firebaseConfig。');
      throw new Error('Invalid Firebase apiKey configuration');
    }

    // Initialize Firebase
    firebase.initializeApp(firebaseConfig);
    const auth = firebase.auth();

    // ========== UI Elements ==========
    const loginSection = document.getElementById('login-section');
    const dashboard = document.getElementById('dashboard');
    const loginBtn = document.getElementById('login-btn');
    const logoutBtn = document.getElementById('logout-btn');
    const fileInput = document.getElementById('file-input');
    const fileLabel = document.querySelector('.file-input-label');
    const templateSelect = document.getElementById('template-select');
    const uploadBtn = document.getElementById('upload-btn');
    const statusDiv = document.getElementById('status');
    const progressBar = document.getElementById('progress-bar');
    const progressFill = document.getElementById('progress-fill');
    const resultSection = document.getElementById('result-section');
    const userEmailDisplay = document.getElementById('user-email-display');
    const userDisplayName = document.getElementById('user-display-name');

    // Cloud Function URL (will be set during deployment)
    const FUNCTION_URL = 'https://us-central1-officeomr-fe542.cloudfunctions.net/recognize_sheet';

    // ========== Authentication ==========
    function showStatus(message, type = 'info') {
      statusDiv.textContent = message;
      statusDiv.className = type;
      setTimeout(() => {
        if (type !== 'error' && type !== 'warning') {
          statusDiv.textContent = '';
          statusDiv.className = '';
        }
      }, 5000);
    }

    loginBtn.addEventListener('click', async () => {
      try {
        const provider = new firebase.auth.GoogleAuthProvider();
        await auth.signInWithPopup(provider);
      } catch (error) {
        console.error('Login error:', error);
        showStatus(`登录失败: ${error.message}`, 'error');
      }
    });

    logoutBtn.addEventListener('click', async () => {
      try {
        await auth.signOut();
      } catch (error) {
        console.error('Logout error:', error);
        showStatus(`退出失败: ${error.message}`, 'error');
      }
    });

    // ========== Authentication State ==========
    auth.onAuthStateChanged(async (user) => {
      if (user) {
        loginSection.style.display = 'none';
        dashboard.style.display = 'block';
        userDisplayName.textContent = user.displayName || '用户';
        userEmailDisplay.textContent = user.email;
      } else {
        loginSection.style.display = 'block';
        dashboard.style.display = 'none';
        resultSection.style.display = 'none';
      }
    });

    // ========== File Upload ==========
    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        fileLabel.classList.add('has-file');
        fileLabel.textContent = `✓ 已选择: ${file.name}`;
        uploadBtn.disabled = false;
      } else {
        fileLabel.classList.remove('has-file');
        fileLabel.innerHTML = '<svg class="file-input-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>点击选择或拖拽文件';
        uploadBtn.disabled = true;
      }
    });

    // ========== Drag & Drop ==========
    fileLabel.addEventListener('dragover', (e) => {
      e.preventDefault();
      fileLabel.style.borderColor = '#667eea';
      fileLabel.style.background = '#f0f4ff';
    });

    fileLabel.addEventListener('dragleave', () => {
      fileLabel.style.borderColor = '#ddd';
      fileLabel.style.background = '#fafafa';
    });

    fileLabel.addEventListener('drop', (e) => {
      e.preventDefault();
      fileLabel.style.borderColor = '#ddd';
      fileLabel.style.background = '#fafafa';
      
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        fileInput.files = files;
        const event = new Event('change', { bubbles: true });
        fileInput.dispatchEvent(event);
      }
    });

    // ========== Upload & Recognition ==========
    uploadBtn.addEventListener('click', async () => {
      const file = fileInput.files[0];
      const template = templateSelect.value;
      const user = auth.currentUser;

      if (!file || !user) {
        showStatus('请先登录并选择文件', 'error');
        return;
      }

      uploadBtn.disabled = true;
      const spinner = uploadBtn.querySelector('.spinner');
      spinner.style.display = 'inline-block';

      progressBar.classList.add('active');
      progressFill.style.width = '0%';

      try {
        // Get Firebase ID token
        const token = await user.getIdToken();

        // Simulate progress
        const progressInterval = setInterval(() => {
          const current = parseFloat(progressFill.style.width);
          if (current < 90) {
            progressFill.style.width = (current + Math.random() * 30) + '%';
          }
        }, 300);

        // Prepare form data
        const formData = new FormData();
        formData.append('image', file);
        formData.append('template', template);

        showStatus(`正在处理 ${file.name}...`, 'info');

        // Call Cloud Function
        const response = await fetch(FUNCTION_URL, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`
          },
          body: formData
        });

        clearInterval(progressInterval);
        progressFill.style.width = '100%';

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.message || `HTTP ${response.status}`);
        }

        const result = await response.json();

        // Display results
        displayResults(result.result);
        showStatus('识别成功！', 'success');

        // Store result for download
        window.currentResult = result.result;

      } catch (error) {
        console.error('Upload error:', error);
        showStatus(`识别失败: ${error.message}`, 'error');
        progressFill.style.width = '0%';
      } finally {
        uploadBtn.disabled = false;
        spinner.style.display = 'none';
        progressBar.classList.remove('active');
      }
    });

    // ========== Display Results ==========
    function displayResults(result) {
      // Student ID
      if (result.student_id && result.student_id.value) {
        document.getElementById('result-student-id').textContent = result.student_id.value;
      } else {
        document.getElementById('result-student-id').textContent = '—';
      }

      // Question type counts from summary
      const summary = result.summary || { single: 0, blank: 0, multi: 0, ambiguous: 0 };
      document.getElementById('result-single').textContent = summary.single || '0';
      document.getElementById('result-blank').textContent = summary.blank || '0';
      document.getElementById('result-multi').textContent = summary.multi || '0';
      document.getElementById('result-ambiguous').textContent = summary.ambiguous || '0';

      // Status
      const statusText = result.status || 'ok';
      document.getElementById('result-status').textContent = statusText;

      // Error section (only show if status is failed or needs_review and has error)
      const errorSection = document.getElementById('result-error-section');
      if ((statusText === 'failed' || statusText === 'needs_review') && result.error) {
        document.getElementById('result-error-code').textContent = result.error.code || '—';
        document.getElementById('result-error-message').textContent = result.error.message || '—';
        errorSection.style.display = 'block';
      } else {
        errorSection.style.display = 'none';
      }

      resultSection.style.display = 'block';
      resultSection.scrollIntoView({ behavior: 'smooth' });
    }

    // ========== Download Results ==========
    document.getElementById('download-result-btn').addEventListener('click', () => {
      if (!window.currentResult) return;

      const dataStr = JSON.stringify(window.currentResult, null, 2);
      const dataBlob = new Blob([dataStr], { type: 'application/json' });
      const url = URL.createObjectURL(dataBlob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `result-${Date.now()}.json`;
      link.click();
      URL.revokeObjectURL(url);
    });

    // ========== New Upload ==========
    document.getElementById('new-upload-btn').addEventListener('click', () => {
      fileInput.value = '';
      fileLabel.classList.remove('has-file');
      fileLabel.innerHTML = '<svg class="file-input-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>点击选择或拖拽文件';
      uploadBtn.disabled = true;
      resultSection.style.display = 'none';
      statusDiv.textContent = '';
      statusDiv.className = '';
    });
  </script>
</body>
</html>
