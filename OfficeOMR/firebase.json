{
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "python311",
    "ignore": [
      "venv",
      "node_modules",
      ".git",
      "__pycache__",
      "*.pyc",
      "*.pyo",
      ".pytest_cache",
      "backup",
      "firebase-debug.log",
      "*-key.json",
      "serviceAccount*.json"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
