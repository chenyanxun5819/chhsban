# 環境變數配置

## 開發環境 (.env.local)

VITE_API_BASE_URL=http://localhost:8787/api

# Google OAuth 2.0 配置
# 需要在 Google Cloud Console 中創建 OAuth 應用
# 支持的重定向 URI:
# - http://localhost:5173/auth/callback (本地開發)
# - https://localhost:5173/auth/callback (本地 HTTPS)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

## 生產環境 (.env.production)

VITE_API_BASE_URL=https://tution-system.astcws.workers.dev/api

# Google OAuth 2.0 生產配置
# 支持的重定向 URI:
# - https://chhsban-tution.pages.dev/auth/callback (Cloudflare Pages 生產)
# - https://mybazaar.my/auth/callback (自訂域名)
# - https://your-domain.chhsban.edu.my/auth/callback (學校域名)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_for_production_here

